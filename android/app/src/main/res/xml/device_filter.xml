<?xml version="1.0" encoding="utf-8"?>
<!--
  TRN Black Pearl / TTGK TE-C.

  Values must be decimal here. The USB manifest filter does not accept hex,
  which is a well-worn way to end up with a filter that silently never
  matches. These are 0x3302 and 0x43E8, the same pair as hidproto.VendorID
  and hidproto.ProductID.
-->
<resources>
    <usb-device vendor-id="13058" product-id="17384" />
</resources>
