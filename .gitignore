# =====================================================================
# Repo-wide ignores. Each subproject also has its own .gitignore; the
# rules here are the safety net so an artifact is never committed just
# because a nested file was moved or deleted.
# =====================================================================

# OS cruft
.DS_Store
Thumbs.db
*.swp
*~

# Editor / AI tool directories
.vscode/
.idea/
*.iml
.claude/

# Environment files
.env
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.log

# ── Node / frontend ──
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.cache/
node_modules/

# ── Go backend ──
# Compiled sidecar, plus the generic Go artifact patterns.
/backend/trncontrol-backend
/backend/*.exe
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
go.work.sum
vendor/

# ── Rust / Tauri ──
/src-tauri/target/
/src-tauri/binaries/
/src-tauri/gen/
/src-tauri/icons/android/
/src-tauri/icons/ios/
/target/

# Packaged installers. These live under src-tauri/target/ already, but
# the patterns stop a copy left elsewhere in the tree from being added.
*.deb
*.rpm
*.AppImage
*.dmg
*.msi
*.msi.zip

# Exception: release binaries linked from the README's Downloads section.
!/builds/*.deb
!/builds/*.exe

# ── Generic build outputs ──
/dist/
/build/

# ── Runtime data ──
# The preset library normally lives in the user config directory, but
# `-presets ./presets.json` would drop one here.
/presets.json
/backend/presets.json

# ── Coverage and misc ──
coverage/
*.tgz
*.orig
*.rej
